<Page x:Class="NewWpfProject.AppSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="AppSelectionPage"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Select Applications to Block" 
                       FontSize="24" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Choose which games and applications should be blocked during your selected time period" 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- Search Bar -->
        <Border Grid.Row="1" 
                Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="6" 
                BorderThickness="1" 
                BorderBrush="{StaticResource BorderBrush}"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" 
                         Grid.Column="0"
                         Text="Search applications..." 
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         GotFocus="SearchTextBox_GotFocus"
                         LostFocus="SearchTextBox_LostFocus"
                         TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock Text="🔍" 
                           Grid.Column="1" 
                           FontSize="16" 
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </Border>
        
        <!-- Apps List -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- List Header -->
                <Border Grid.Row="0" 
                        BorderThickness="0,0,0,1" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        Padding="0,0,0,12" 
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox x:Name="SelectAllCheckBox" 
                                  Grid.Column="0"
                                  Content="Select All" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Checked="SelectAllCheckBox_Checked"
                                  Unchecked="SelectAllCheckBox_Unchecked"/>
                        
                        <TextBlock Text="Application" 
                                   Grid.Column="1" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="24,0,0,0"/>
                        
                        <TextBlock Text="Selected: 0" 
                                   x:Name="SelectedCountText" 
                                   Grid.Column="2" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- Scrollable Apps List -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AppsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" 
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        CornerRadius="6"
                                        MouseEnter="AppItem_MouseEnter"
                                        MouseLeave="AppItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- App Icon Placeholder -->
                                        <Border Grid.Column="0" 
                                                Width="48" 
                                                Height="48" 
                                                Background="{StaticResource BorderBrush}" 
                                                CornerRadius="8"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="🎮" 
                                                       FontSize="24" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- App Info -->
                                        <StackPanel Grid.Column="1" 
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="15" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Path}" 
                                                       FontSize="12" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        
                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="2" 
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Checked="AppCheckBox_Checked"
                                                  Unchecked="AppCheckBox_Unchecked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

