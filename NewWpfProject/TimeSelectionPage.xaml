<Page x:Class="NewWpfProject.TimeSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="TimeSelectionPage"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="Set Time Block Schedule" 
                       FontSize="24" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Configure when applications should be blocked. Choose your start and end times." 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- Time Selection Card -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}"
                MaxWidth="600"
                HorizontalAlignment="Left">
            <StackPanel>
                <!-- Daily Schedule Section -->
                <TextBlock Text="Daily Schedule" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,24"/>
                
                <!-- Start Time -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Block Start Time" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Hour -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource BackgroundBrush}" 
                                CornerRadius="6" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="16,14"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Hour" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="StartHourComboBox" 
                                          Grid.Row="1"
                                          FontSize="16" 
                                          FontWeight="SemiBold"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          SelectedIndex="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        
                        <!-- Separator -->
                        <TextBlock Text=":" 
                                   Grid.Column="1" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                        
                        <!-- Minute -->
                        <Border Grid.Column="2" 
                                Background="{StaticResource BackgroundBrush}" 
                                CornerRadius="6" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="16,14"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Minute" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="StartMinuteComboBox" 
                                          Grid.Row="1"
                                          FontSize="16" 
                                          FontWeight="SemiBold"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          SelectedIndex="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
                
                <!-- End Time -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Block End Time" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Hour -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource BackgroundBrush}" 
                                CornerRadius="6" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="16,14"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Hour" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="EndHourComboBox" 
                                          Grid.Row="1"
                                          FontSize="16" 
                                          FontWeight="SemiBold"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          SelectedIndex="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        
                        <!-- Separator -->
                        <TextBlock Text=":" 
                                   Grid.Column="1" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                        
                        <!-- Minute -->
                        <Border Grid.Column="2" 
                                Background="{StaticResource BackgroundBrush}" 
                                CornerRadius="6" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="16,14"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Minute" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="EndMinuteComboBox" 
                                          Grid.Row="1"
                                          FontSize="16" 
                                          FontWeight="SemiBold"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          SelectedIndex="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
                
                <!-- Time Range Display -->
                <Border Background="{StaticResource SelectedBrush}" 
                        CornerRadius="6" 
                        Padding="20,16"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Block Duration" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="DurationText" 
                                   Text="00:00 - 12:00 (12 hours)" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Save Schedule" 
                            Style="{StaticResource ModernButton}"
                            Padding="32,12"
                            Click="SaveSchedule_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

